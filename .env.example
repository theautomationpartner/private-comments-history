# Copiá este archivo como .env.local (que está gitignoreado) y completá los valores.
# El .env.example SÍ se commitea (es la plantilla, sin secretos). El .env.local NO.

# --- Token de monday (SERVER-SIDE ONLY) ---
# Lo usa SOLO la función serverless /api/monday. Sin prefijo VITE_ para que el frontend NO lo vea.
# En Vercel: cargarlo en Project Settings → Environment Variables (no en el repo).
MONDAY_TOKEN=

# --- Modo mock (opcional, para dev sin red) ---
# VITE_ sí se expone al browser, pero esto no es secreto (solo un flag).
# Poné 1 para usar datos de ejemplo; borralo/0 para pegar a monday real vía el proxy.
# ⚠️ OJO: con `npm run dev` (Vite solo) el proxy /api/monday NO existe → para probar con
# datos reales en local usá `vercel dev` (levanta las funciones de api/ y lee este archivo).
VITE_MONDAY_MOCK=1

# --- Guardia opcional del proxy (anti-bots) ---
# Si en Vercel seteás APP_PROXY_KEY, poné acá el MISMO valor para que la app lo mande
# en el header x-app-key. No es un secreto fuerte (viaja en el bundle del browser).
# VITE_APP_PROXY_KEY=

# Mail de la persona duena del historial (dato personal: no va en el codigo)
VITE_OWNER_EMAIL=

# Nombre de la columna de monday que alimenta el historial (se muestra en pantalla)
VITE_SOURCE_COLUMN=
